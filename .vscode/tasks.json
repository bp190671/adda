    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ADDA Debug",
            "type": "shell",
            "command": "bear",
            "args": [
                "--",
                "make",
                "-s",
                "OPTIONS=DEBUG",
                "-C",
                "src",
                "seq"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build ADDA in debug mode using Makefile in the src folder"
        },
        {
            "label": "Cleanseq ADDA",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "src",
                "cleanseq"
            ],
